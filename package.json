{
  "name": "@openai/guardrails",
  "version": "0.2.1",
  "description": "OpenAI Guardrails: A TypeScript framework for building safe and reliable AI systems",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "guardrails": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run clean && npm run build",
    "cli": "node dist/cli.js",
    "eval": "node dist/cli.js eval",
    "eval:example": "node dist/examples/run-eval.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "biome check --error-on-warnings docs/.vitepress/config.mts docs/.vitepress/theme/index.ts scripts/docs.test.mjs && npm run docs:build && node --test scripts/docs.test.mjs",
    "format:check": "biome format ."
  },
  "keywords": [
    "guardrails",
    "ai",
    "safety",
    "validation",
    "typescript",
    "openai"
  ],
  "author": "OpenAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openai/openai-guardrails-js.git"
  },
  "bugs": {
    "url": "https://github.com/openai/openai-guardrails-js/issues"
  },
  "homepage": "https://openai.github.io/openai-guardrails-js/",
  "dependencies": {
    "@openai/agents": "^0.1.3",
    "openai": "^4.55.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^1.19.17"
    },
    "vitepress": {
      "vite": "^6.4.3"
    }
  }
}
